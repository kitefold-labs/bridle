#!/bin/sh
# bridle-helper: optional companion for the Bridle Android SSH client.
#
# Copyright 2026 Kitefold Labs. Licensed under the Apache License, Version 2.0.
#
# Records Claude Code session state (working / waiting / idle / exited) from Claude Code hooks so
# Bridle can show status badges and notifications. It needs no root, runs no daemon, makes no
# network connections, and only writes under $XDG_STATE_HOME/bridle (default ~/.local/state/bridle).
#
#   bridle-helper version                Print the protocol version.
#   bridle-helper hook <EventName>       Called by Claude Code hooks; reads the hook JSON on stdin.
#   bridle-helper list                   Print one JSON object per known session.
#   bridle-helper prune [days]           Remove state older than N days (default 7).
#   bridle-helper install-hooks [--dry-run]    Add hooks to ~/.claude/settings.json (backs it up).
#   bridle-helper uninstall-hooks        Remove Bridle's hooks from ~/.claude/settings.json.
#   bridle-helper install-shell [--dry-run] [bash] [zsh]
#                                        Source the shell integration from ~/.bashrc and/or
#                                        ~/.zshrc (backs them up). Without shells: each rc file
#                                        that exists, plus the login shell's.
#   bridle-helper uninstall-shell        Remove that from both rc files and delete the scripts.
#
# Requires: POSIX sh, sed, awk, date, mv, mkdir. install-hooks also needs python3 (or jq).

set -u

HELPER_VERSION=1
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bridle/sessions"
SETTINGS="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
SELF_PATH="${BRIDLE_HELPER_PATH:-$HOME/.local/share/bridle/bridle-helper}"
HOOK_EVENTS="SessionStart UserPromptSubmit PreToolUse Notification Stop SessionEnd"
SHARE_DIR="$(dirname "$SELF_PATH")"
BLOCK_BEGIN="# >>> bridle shell integration >>>"
BLOCK_END="# <<< bridle shell integration <<<"

die() {
  printf 'bridle-helper: %s\n' "$*" >&2
  exit 2
}

# Extract a top-level string field from a JSON document (good enough for hook payloads, which
# are flat objects with simple string values). Prints the value still JSON-escaped (a valid JSON
# string body), or nothing if the field is absent.
json_field() {
  # Extended regex (-E, in POSIX.1-2024 and every BSD/GNU/busybox sed): BRE `\|` is a GNU
  # extension, and without it macOS sed would silently extract nothing.
  printf '%s' "$1" | tr '\n' ' ' | sed -n -E "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"(([^\"\\\\]|\\\\.)*)\".*/\\1/p"
}

# Escape a value for embedding in a JSON string.
json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\000-\037'
}

# An already-escaped JSON string body: just drop control characters.
json_clean() {
  printf '%s' "$1" | tr -d '\000-\037'
}

# Keep only characters that are safe in a file name.
safe_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_' | cut -c1-80
}

state_for_event() {
  case "$1" in
    SessionStart) echo idle ;;
    UserPromptSubmit | PreToolUse) echo working ;;
    Notification)
      case "$2" in
        *permission*) echo waiting_permission ;;
        *) echo waiting_input ;;
      esac
      ;;
    Stop) echo idle ;;
    SessionEnd) echo exited ;;
    *) echo unknown ;;
  esac
}

cmd_hook() {
  event="${1:-}"
  [ -n "$event" ] || die "usage: bridle-helper hook <EventName>"
  payload="$(cat)"
  session_id="$(json_field "$payload" session_id)"
  cwd="$(json_field "$payload" cwd)"
  notification_type="$(json_field "$payload" notification_type)"
  message="$(json_field "$payload" message)"
  tmux_session=""
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1; then
    tmux_session="$(tmux display-message -p '#S' 2>/dev/null || true)"
  fi
  state="$(state_for_event "$event" "$notification_type $message")"
  key="$(safe_name "${tmux_session:-${session_id:-unknown}}")"
  now="$(date +%s)"

  # Before mkdir, so the state directory itself is private too.
  umask 077
  mkdir -p "$STATE_DIR" || exit 0
  tmp="$STATE_DIR/.$key.$$"
  printf '{"v":%s,"state":"%s","event":"%s","tmux_session":"%s","session_id":"%s","cwd":"%s","message":"%s","ts":%s}\n' \
    "$HELPER_VERSION" "$state" "$(json_escape "$event")" "$(json_escape "$tmux_session")" \
    "$(json_clean "$session_id")" "$(json_clean "$cwd")" "$(json_clean "$message")" "$now" >"$tmp" &&
    mv -f "$tmp" "$STATE_DIR/$key.json"
  # Hooks must never block or fail Claude Code.
  exit 0
}

cmd_list() {
  [ -d "$STATE_DIR" ] || exit 0
  for f in "$STATE_DIR"/*.json; do
    [ -f "$f" ] && cat "$f"
  done
  exit 0
}

cmd_prune() {
  days="${1:-7}"
  case "$days" in '' | *[!0-9]*) die "prune: days must be a number" ;; esac
  [ -d "$STATE_DIR" ] && find "$STATE_DIR" -name '*.json' -type f -mtime +"$days" -exec rm -f {} +
  exit 0
}

# Merge or remove our hooks with python3 (preferred) — never with ad-hoc text edits.
edit_settings() {
  mode="$1"
  dry_run="$2"
  command -v python3 >/dev/null 2>&1 || die "python3 is required to edit $SETTINGS; add hooks manually (see Bridle docs)"
  mkdir -p "$(dirname "$SETTINGS")"
  BRIDLE_MODE="$mode" BRIDLE_DRY_RUN="$dry_run" BRIDLE_SETTINGS="$SETTINGS" BRIDLE_SELF="$SELF_PATH" \
    BRIDLE_EVENTS="$HOOK_EVENTS" python3 - <<'PY'
import json, os, shlex, shutil, sys, tempfile, time

# Edit the file a symlinked settings.json points to (dotfile managers), not replace the link.
path = os.path.realpath(os.environ["BRIDLE_SETTINGS"])
mode = os.environ["BRIDLE_MODE"]
dry = os.environ["BRIDLE_DRY_RUN"] == "1"
helper = os.environ["BRIDLE_SELF"]
events = os.environ["BRIDLE_EVENTS"].split()

try:
    with open(path, encoding="utf-8") as fh:
        settings = json.load(fh)
except FileNotFoundError:
    settings = {}
except json.JSONDecodeError as err:
    sys.exit(f"bridle-helper: {path} is not valid JSON ({err}); not modified")
if not isinstance(settings, dict):
    sys.exit(f"bridle-helper: {path} is not a JSON object; not modified")

hooks = settings.setdefault("hooks", {})
if not isinstance(hooks, dict) or any(not isinstance(v, list) for v in hooks.values()):
    sys.exit(f"bridle-helper: unexpected \"hooks\" layout in {path}; not modified")
def ours(entry):
    inner = entry.get("hooks", [])
    return isinstance(inner, list) and any(
        isinstance(h, dict) and "bridle-helper" in str(h.get("command", "")) for h in inner
    )

changed = False
for event in events:
    entries = [e for e in hooks.get(event, []) if isinstance(e, dict)]
    kept = [e for e in entries if not ours(e)]
    if mode == "install":
        kept.append({"hooks": [{"type": "command", "command": f"{shlex.quote(helper)} hook {event}", "timeout": 5}]})
    if kept != hooks.get(event, []):
        changed = True
    if kept:
        hooks[event] = kept
    else:
        hooks.pop(event, None)
if not hooks:
    settings.pop("hooks", None)

text = json.dumps(settings, indent=2) + "\n"
if dry:
    sys.stdout.write(text)
elif changed:
    if os.path.exists(path):
        shutil.copy2(path, path + ".bridle-backup-" + time.strftime("%Y%m%d%H%M%S"))
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix=".settings.")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)
print("BRIDLE_HOOKS_" + ("CHANGED" if changed else "UNCHANGED"), file=sys.stderr)
PY
}

rc_file() {
  case "$1" in
    bash) printf '%s' "$HOME/.bashrc" ;;
    zsh) printf '%s' "${ZDOTDIR:-$HOME}/.zshrc" ;;
  esac
}

# The path to source, as "$HOME/..." when it is under $HOME so the rc file survives a moved home.
integration_path() {
  path="$SHARE_DIR/shell-integration.$1"
  # shellcheck disable=SC2016 # $HOME is written literally, for the rc file to expand
  case "$path" in
    "$HOME"/*) printf '"$HOME%s"' "${path#"$HOME"}" ;;
    *) printf "'%s'" "$(printf '%s' "$path" | sed "s/'/'\\\\''/g")" ;;
  esac
}

# Prints $1 without Bridle's block (and the blank line before it), or fails if the markers
# don't pair up, so a damaged block can never swallow the rest of the file.
strip_block() {
  [ -f "$1" ] || return 0
  awk -v b="$BLOCK_BEGIN" -v e="$BLOCK_END" '
    $0 == b { if (inside) exit 3; inside = 1; blank = 0; next }
    $0 == e { if (!inside) exit 3; inside = 0; next }
    inside { next }
    $0 == "" { blank++; next }
    { while (blank > 0) { print ""; blank-- } print }
    END { if (inside) exit 3; while (blank > 0) { print ""; blank-- } }
  ' "$1"
}

# Writes $2 to rc file $1 if it differs, after a timestamped backup. Writes through the path
# (not mv) so a symlinked rc file stays a symlink and keeps its permissions.
replace_rc() {
  if [ -f "$1" ] && cmp -s "$2" "$1"; then
    rm -f "$2"
    return 1
  fi
  [ -f "$1" ] && cp -p "$1" "$1.bridle-backup-$(date +%Y%m%d%H%M%S)"
  cat "$2" >"$1" && rm -f "$2"
}

cmd_install_shell() {
  dry_run=0
  shells=""
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry_run=1 ;;
      bash | zsh) shells="$shells $arg" ;;
      *) die "install-shell: unknown argument: $arg" ;;
    esac
  done
  if [ -z "$shells" ]; then
    login="$(basename "${SHELL:-}")"
    for sh in bash zsh; do
      if [ -f "$(rc_file "$sh")" ] || [ "$login" = "$sh" ]; then shells="$shells $sh"; fi
    done
  fi
  [ -n "$shells" ] || die "install-shell: no ~/.bashrc or ~/.zshrc, and the login shell is neither bash nor zsh"
  changed=0
  for sh in $shells; do
    [ -r "$SHARE_DIR/shell-integration.$sh" ] || die "install-shell: $SHARE_DIR/shell-integration.$sh is missing"
    rc="$(rc_file "$sh")"
    tmp="$(mktemp "${TMPDIR:-/tmp}/bridle-rc.XXXXXX")" || exit 1
    if ! strip_block "$rc" >"$tmp"; then
      rm -f "$tmp"
      die "install-shell: Bridle's block in $rc is damaged; fix or remove it by hand"
    fi
    if [ -s "$tmp" ]; then echo >>"$tmp"; fi
    {
      echo "$BLOCK_BEGIN"
      echo "# Added by bridle-helper install-shell; remove with bridle-helper uninstall-shell."
      echo "if [ -r $(integration_path "$sh") ]; then . $(integration_path "$sh"); fi"
      echo "$BLOCK_END"
    } >>"$tmp"
    if [ "$dry_run" = 1 ]; then
      echo "==> $rc"
      cat "$tmp"
      rm -f "$tmp"
    elif replace_rc "$rc" "$tmp"; then
      changed=1
    fi
  done
  [ "$dry_run" = 1 ] || shell_marker "$changed"
}

cmd_uninstall_shell() {
  changed=0
  for sh in bash zsh; do
    rc="$(rc_file "$sh")"
    [ -f "$rc" ] || continue
    tmp="$(mktemp "${TMPDIR:-/tmp}/bridle-rc.XXXXXX")" || exit 1
    if ! strip_block "$rc" >"$tmp"; then
      rm -f "$tmp"
      die "uninstall-shell: Bridle's block in $rc is damaged; fix or remove it by hand"
    fi
    if replace_rc "$rc" "$tmp"; then changed=1; fi
  done
  rm -f "$SHARE_DIR/shell-integration.bash" "$SHARE_DIR/shell-integration.zsh"
  shell_marker "$changed"
}

shell_marker() {
  if [ "$1" = 1 ]; then echo BRIDLE_SHELL_CHANGED >&2; else echo BRIDLE_SHELL_UNCHANGED >&2; fi
}

main() {
  sub="${1:-}"
  [ $# -gt 0 ] && shift
  case "$sub" in
    version) echo "bridle-helper $HELPER_VERSION" ;;
    hook) cmd_hook "$@" ;;
    list) cmd_list ;;
    prune) cmd_prune "$@" ;;
    install-hooks)
      if [ "${1:-}" = "--dry-run" ]; then edit_settings install 1; else edit_settings install 0; fi
      ;;
    uninstall-hooks) edit_settings uninstall 0 ;;
    install-shell) cmd_install_shell "$@" ;;
    uninstall-shell) cmd_uninstall_shell ;;
    *) die "usage: bridle-helper {version|hook <event>|list|prune [days]|install-hooks [--dry-run]|uninstall-hooks|install-shell [--dry-run] [bash] [zsh]|uninstall-shell}" ;;
  esac
}

main "$@"
