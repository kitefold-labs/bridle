<?xml version="1.0" encoding="utf-8"?>
<!-- SSH doesn't use this, but any HTTP the app ever does must be TLS with system CAs only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
