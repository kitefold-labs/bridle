<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device via Android backup or device transfer: host configs, known hosts and
     encrypted key blobs stay local. Users move configuration with Bridle's encrypted export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
