                android:strokeColor="@color/bridle_icon_kite"
                android:strokeWidth="2.5"
                android:pathData="M12.5,9 H19.5 A3.5,3.5 0 0 1 23,12.5 V19.5 A3.5,3.5 0 0 1 19.5,23 H12.5 A3.5,3.5 0 0 1 9,19.5 V12.5 A3.5,3.5 0 0 1 12.5,9 Z" />
