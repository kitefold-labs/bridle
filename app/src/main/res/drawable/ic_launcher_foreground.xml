<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:translateX="18" android:translateY="18" android:scaleX="2.25" android:scaleY="2.25">
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/bridle_icon_line"
            android:strokeWidth="2.5"
            android:pathData="M10,11.5 H22 A3.5,3.5 0 0 1 22,18.5 H10 A3.5,3.5 0 0 1 10,11.5 Z" />
        <group android:rotation="45" android:pivotX="16" android:pivotY="16">
            <path
