<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bridle" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Bridle.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bridle_sky</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Bridle</item>
    </style>
</resources>
