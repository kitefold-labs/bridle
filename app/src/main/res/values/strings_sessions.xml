    <!-- Dialogs -->
    <string name="dialog_cancel">Cancel</string>
    <string name="stop_title">Stop %1$s?</string>
    <string name="stop_body">This kills the tmux session and everything running in it.</string>
    <string name="stop_confirm">Stop</string>
    <string name="delete_profile_title">Delete %1$s?</string>
    <string name="delete_profile_body">The profile is removed. A running tmux session keeps running.</string>
    <string name="delete_confirm">Delete</string>
    <string name="install_title">Install bridle-helper?</string>
    <string name="install_body">Bridle uploads a small shell script to ~/.local/share/bridle/bridle-helper and checks its SHA-256 on the host. It needs no root, runs no daemon and never connects to the network.</string>
    <string name="install_checksum">SHA-256</string>
    <string name="install_hooks">Also add Claude Code hooks to ~/.claude/settings.json (a backup is kept). Without hooks the helper has no status to report.</string>
    <string name="install_confirm">Install</string>
    <string name="uninstall_title">Remove bridle-helper?</string>
    <string name="uninstall_body">Removes its Claude Code hooks, the shell integration and the script. Claude status goes back to being guessed from the screen.</string>
    <string name="uninstall_confirm">Remove</string>
    <string name="shell_install_title">Install shell integration?</string>
    <string name="shell_install_body">Bridle uploads bridle-helper and two shell scripts to ~/.local/share/bridle and checks their SHA-256 on the host. bridle-helper then adds a block that loads the scripts to the end of ~/.bashrc and ~/.zshrc: each one that exists, plus your login shell\'s. A backup of each file is kept. Shells opened afterwards use it.</string>
    <string name="shell_uninstall_title">Remove shell integration?</string>
    <string name="shell_uninstall_body">Removes the block from ~/.bashrc and ~/.zshrc (a backup is kept) and deletes the scripts. Shells already open keep it until they exit.</string>

