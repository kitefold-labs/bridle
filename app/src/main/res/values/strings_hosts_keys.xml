    <string name="key_install_title">Install on host</string>
    <string name="key_install_text">Logs in once with your password, adds this public key to ~/.ssh/authorized_keys and makes it the host\'s key. The password isn\'t stored.</string>
    <string name="key_install_host">Host</string>
    <string name="key_install_button">Install</string>
    <string name="key_install_no_hosts">Add a host first, then install the key on it.</string>
