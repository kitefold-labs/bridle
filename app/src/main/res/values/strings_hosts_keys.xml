    <string name="known_hosts_forget_text">The next connection will show the server\'s fingerprint and ask you to trust it again.</string>

    <!-- Connection dialogs -->
    <string name="trust_title">Trust this host?</string>
    <string name="trust_text">This is the first connection to %1$s. Check that the server\'s key fingerprint is:</string>
    <string name="trust_how_to_check">On the server, run: ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub (or the .pub file for this key type).</string>
    <string name="trust_accept">Trust and connect</string>
    <string name="password_title">Password for %1$s on %2$s</string>
    <string name="password_text">Used for this login only and never stored.</string>
    <string name="password_label">Password</string>
    <string name="password_submit">Log in</string>
    <string name="host_key_changed_title">Host key changed!</string>
    <string name="host_key_changed_text">%1$s presented a different key from the one you trusted. Someone may be intercepting the connection (a man-in-the-middle attack), or the server was reinstalled or its keys were regenerated. The connection was blocked.</string>
    <string name="host_key_changed_old">Previously trusted</string>
    <string name="host_key_changed_new">Now presented (%1$s)</string>
    <string name="host_key_changed_advice">Only forget the old key if you know why it changed, for example because you reinstalled the server. Check the new fingerprint on the server with ssh-keygen -lf.</string>
    <string name="host_key_changed_keep_blocked">Keep blocked</string>
    <string name="host_key_changed_forget">Forget old key</string>
    <string name="host_key_changed_forget_confirm">The old key of %1$s is removed. The next connection shows the new fingerprint and asks you to trust it.</string>

    <!-- Biometric prompt for keys that require it -->
    <string name="biometric_title">Unlock key</string>
