    <!-- Known hosts -->
    <string name="known_hosts_title">Known hosts</string>
    <string name="known_hosts_empty">No trusted host keys yet. Each server\'s key is saved the first time you trust it.</string>
    <string name="known_hosts_forget">Forget</string>
    <string name="known_hosts_forget_host">Forget the key of %1$s</string>
